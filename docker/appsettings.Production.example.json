{
  "Bot": {
    // Optional bot-wide connection settings. Restart after changing these values.
    // Use a System One server root, not a /v1/systemone URL.
    // Configure Bot__SystemOne__ApiToken through the environment if a bearer key is needed.
    // A reachable endpoint does not enable questionnaire screening; use /config set in Discord.
    "SystemOne": {
      "BaseUrl": "",
      "Model": "loaded",
      "TimeoutSeconds": 10
    },
    // Set Bot__Discord__Token in docker-compose.yml.
    // The base appsettings uses mongodb://igor-bot-db:27017/ for the supplied Compose service.
    // Override ConnectionStrings__MongoDB in the environment for another database host.
    // Leave Guilds empty and use /config setup or /config setup-honeypot in Discord.
    // For a custom questionnaire at first import, adapt src/appsettings.Example.json.
    // Existing guild configs live in MongoDB and are not overwritten from this file.
    "Guilds": {}
  }
}
